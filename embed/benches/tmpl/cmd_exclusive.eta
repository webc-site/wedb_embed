<text x="0" y="11" class="txt cmd-name"><%= it.cmd %></text>
<text x="322" y="11" class="txt cmd-desc" text-anchor="end"><%= it.desc %></text>
<rect x="0" y="16" width="<%= it.wedb_bar_w %>" height="10" rx="2.5" fill="url(#wedb-blue-grad)"/>
<text x="<%= it.wedb_label_x %>" y="24.5" text-anchor="<%= it.wedb_label_anchor %>" class="txt <%= it.wedb_label_class %>"><%= it.wedb_label_text %></text>
